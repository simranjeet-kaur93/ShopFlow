# ==============================================================================
# ShopFlow - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT store real credentials, secrets, or production keys in this template.
# ==============================================================================

# Node Environment
NODE_ENV=development
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Service HTTP / REST & gRPC Port Allocations
# ------------------------------------------------------------------------------
# API Gateway (Public REST Entrypoint)
PORT_API_GATEWAY=3000

# User Service (Dual: HTTP Health/Telemetry + gRPC Service)
PORT_USER_HTTP=3001
PORT_USER_GRPC=50051

# Product Service (Dual: HTTP Health/Telemetry + gRPC Service)
PORT_PRODUCT_HTTP=3002
PORT_PRODUCT_GRPC=50052

# Order Service (Dual: HTTP Health/Telemetry + gRPC Service)
PORT_ORDER_HTTP=3003
PORT_ORDER_GRPC=50053

# Payment Service (Async-first: HTTP Health/Telemetry, Worker via RabbitMQ)
PORT_PAYMENT_HTTP=3004

# Inventory Service (Dual: HTTP Health/Telemetry + gRPC Service)
PORT_INVENTORY_HTTP=3005
PORT_INVENTORY_GRPC=50055

# Shipping Service (Dual: HTTP Health/Telemetry + gRPC Service)
PORT_SHIPPING_HTTP=3006
PORT_SHIPPING_GRPC=50056

# Notification Service (Async-first: HTTP Health/Telemetry, Worker via RabbitMQ)
PORT_NOTIFICATION_HTTP=3007

# Frontend SPA
PORT_FRONTEND=5173
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# PostgreSQL Databases (Database-per-Service Pattern)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_placeholder

# Connection URLs for Prisma ORM per service
USER_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/shopflow_user?schema=public
PRODUCT_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/shopflow_product?schema=public
ORDER_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/shopflow_order?schema=public
PAYMENT_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/shopflow_payment?schema=public
INVENTORY_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/shopflow_inventory?schema=public
SHIPPING_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/shopflow_shipping?schema=public
NOTIFICATION_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/shopflow_notification?schema=public

# ------------------------------------------------------------------------------
# RabbitMQ Message Broker
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}
RABBITMQ_DEFAULT_EXCHANGE=shopflow.events

# ------------------------------------------------------------------------------
# Redis Cache & Session Store
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# S3-Compatible Object Storage (MinIO Local / AWS S3 Cloud)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_ACCESS_KEY=minio_local_placeholder
S3_SECRET_KEY=minio_local_placeholder
S3_BUCKET_NAME=shopflow-media
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# Authentication & Security (Placeholders)
# ------------------------------------------------------------------------------
JWT_SECRET=change_me_to_a_secure_random_string_in_local_env
JWT_EXPIRATION_TIME=15m
JWT_REFRESH_EXPIRATION_TIME=7d
